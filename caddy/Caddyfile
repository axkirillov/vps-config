blog.axkirillov.com {
    # Static recipe pages, served straight out of this repo (recipes/)
    redir /recipes /recipes/ permanent
    handle_path /recipes/* {
        root * /srv/recipes
        encode gzip
        file_server
    }

    # Tumble-dryer report (trockner/): one self-contained HTML page plus the
    # manufacturers' instruction PDFs. Same pattern as recipes — nothing is
    # copied to the server, publishing is git pull + compose up in deploy.sh.
    redir /trockner /trockner/ permanent
    handle_path /trockner/* {
        root * /srv/trockner
        encode gzip
        file_server
    }

    reverse_proxy 127.0.0.1:2368
}

# OpenClaw Gateway. TLS terminates here and the Gateway itself is published on
# 127.0.0.1:18789 only (see openclaw-app/docker-compose.yml), so this block is
# the single public entry point. Sign-in needs the bearer token from
# openclaw-app/.env.
# DNS: claw.axkirillov.com A/AAAA -> this host (Hetzner DNS).
# The Gateway attributes forwarded client headers, so its `gateway.trustedProxies`
# must list the hop this proxy arrives from: Docker rewrites the loopback source
# to the compose network's gateway (172.24.0.1). See openclaw-app/docker-compose.yml.
# Fallback when DNS or TLS is broken:
#   ssh -N -L 18789:127.0.0.1:18789 root@116.203.206.66
#   open http://127.0.0.1:18789/
claw.axkirillov.com {
    reverse_proxy 127.0.0.1:18789 {
        # Not a live fix: with no global trusted_proxies configured, this Caddy
        # already discards a client-supplied X-Forwarded-For and sets the header
        # to the immediate peer (verified against this same image, with and
        # without these lines). They pin that behavior explicitly, since Caddy's
        # default depends on trust configuration and image version, and they add
        # the X-Real-IP that the default omits.
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}

supabase.axkirillov.com {
    # CORS
    header Access-Control-Allow-Origin *
    header Access-Control-Allow-Headers "Authorization, Content-Type, apikey, X-Client-Info, Prefer, Content-Profile, content-profile, Accept-Profile, accept-profile"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Expose-Headers "content-profile, Content-Profile, accept-profile, Accept-Profile, content-location, content-range, Prefer"

    # Handle CORS preflight
    @options method OPTIONS
    respond @options 204

    # Auth (GoTrue) — strip /auth/v1 prefix
    handle_path /auth/v1/* {
        reverse_proxy 127.0.0.1:9999 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Expose-Headers
        }
    }
    # PostgREST REST API (strip /rest/v1 prefix)
    handle_path /rest/v1/* {
        reverse_proxy 127.0.0.1:3001 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Expose-Headers
        }
    }
    # Realtime WebSocket — rewrite /realtime/v1/ to /socket/
    handle /realtime/v1/* {
        uri replace "/realtime/v1/" "/socket/"
        reverse_proxy 127.0.0.1:4000 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Expose-Headers
        }
    }
    # Catch-all
    respond "Supabase minimal endpoint — use /rest/v1, /auth/v1, or /realtime/v1" 200
}

# ---------------------------------------------------------------------------
# Recipes currently live at https://blog.axkirillov.com/recipes/ because that
# host already has a certificate and a public AAAA record.
#
# To give them their own subdomain instead:
#   1. add an AAAA record  recipes.axkirillov.com -> 2a01:4f8:1c1a:fc02::1
#      (Hetzner DNS; there is no wildcard record)
#   2. replace the /recipes block above with these lines:
#
# recipes.axkirillov.com {
#     root * /srv/recipes
#     encode gzip
#     file_server
# }
#
# The files themselves never move — the container mount stays /srv/recipes.
# ---------------------------------------------------------------------------
