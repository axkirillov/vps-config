# Copy to openclaw-app/.env on the VPS (the file is gitignored) and fill in.
#   cp openclaw-app/.env.example openclaw-app/.env
#   sed -i "s|^OPENCLAW_GATEWAY_TOKEN=.*|OPENCLAW_GATEWAY_TOKEN=$(openssl rand -hex 32)|" openclaw-app/.env

# --- Image ---------------------------------------------------------------
# Official prebuilt images. `latest` tracks stable; pin a release tag such as
# 2026.9.3 for reproducibility. `-browser` variants bundle Chromium (~1 GB more).
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# --- Host state (bind-mount sources, outside the repo) -------------------
OPENCLAW_CONFIG_DIR=/root/.openclaw
OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/root/.openclaw-auth-profile-secrets

# --- Gateway -------------------------------------------------------------
# Bearer token for the Control UI and API. Treat as a credential.
OPENCLAW_GATEWAY_TOKEN=
# lan = listen on all interfaces inside the container; the host publishes it on
# 127.0.0.1 only (see docker-compose.yml).
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=UTC

# --- Model provider (used by onboarding / the agent) ---------------------
# Any one of these, depending on which provider you authenticate with.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Channels (optional, uncomment the one you use) ----------------------
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
